<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Тесты запускают WinForms-приложение BookStore.GUI через Appium, поэтому работают только в Windows. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Appium.WebDriver" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="MSTest" Version="4.4.1" />
    <PackageReference Include="Selenium.Support" Version="4.50.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.50.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookStore.API\BookStore.API.csproj" />
    <!-- Ссылка только задаёт порядок сборки: тесты запускают exe приложения из bin проекта BookStore.GUI,
         а Private="false" не даёт скопировать файлы приложения (и его appsettings.json) в каталог тестов. -->
    <ProjectReference Include="..\BookStore.GUI\BookStore.GUI.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
